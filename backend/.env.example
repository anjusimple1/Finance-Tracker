# Copy this file to .env in the same folder (backend/.env) and adjust values.

PORT=5001

# Local MongoDB (default) or MongoDB Atlas, e.g.:
# MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/personal_finance_tracker
MONGO_URI=mongodb://127.0.0.1:27017/personal_finance_tracker

# Use a long random string in production (e.g. openssl rand -hex 32)
JWT_SECRET=change_this_to_a_long_random_string_in_production
JWT_EXPIRE=30d
